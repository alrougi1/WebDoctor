flowchart TD
    URL["Developer enters URL<br/>(CLI or Web Dashboard)"] --> Runner["Test Runner Orchestrator"]
    Runner --> AUTH["Authentication<br/>form login / saved session<br/>auth-cookie audit"]
    Runner --> HTTP["HTTP & SSL Health<br/>status, total response time, redirects,<br/>TLS, compression"]
    Runner --> SEC["Security Headers<br/>HSTS, CSP, XFO, nosniff, cookies"]
    Runner --> SEO["SEO & Accessibility<br/>title, viewport, lang, alt, form labels"]
    Runner --> LNK["Broken Link Crawler<br/>unique &lt;a&gt; / &lt;img&gt; concurrent check"]
    Runner --> BRW["Headless Browser (Playwright)<br/>JS exceptions, console, failed requests,<br/>timing waterfall, screenshot"]
    Runner --> MON["Hard Monkey Test<br/>seeded actions, safety guards, full trace"]
    AUTH & HTTP & SEC & SEO & LNK & BRW & MON --> AGG["Score & Grade Engine<br/>Grade A-F, 0-100 score"]
    AGG --> ENV["Environment issues<br/>visible, never scored"]
    AGG --> DIAG["Diagnostics Engine"]
    DIAG --> RULE["Rule-based root cause<br/>(free, offline)"]
    DIAG --> AI["AI diagnosis<br/>single provider or side-by-side compare"]
    RULE & AI & ENV --> REP["Reporters"]
    REP --> HTML["Interactive HTML report"]
    REP --> MD["One-page Markdown"]
    REP --> JSON["CI JSON"]
    REP --> PDF["PDF report (WeasyPrint / Chromium)"]
